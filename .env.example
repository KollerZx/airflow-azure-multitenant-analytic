# =============================================================================
# CONFIGURAÇÕES DO AIRFLOW E BANCO DE DADOS
# =============================================================================

# --- Configurações do Airflow ---
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
# Chave Fernet para criptografia de dados sensíveis no Airflow
# Use o comando abaixo para gerar uma nova chave:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Credenciais do Airflow Web UI
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# --- Configurações do Banco de Dados de Produção (onde estão os tickets) ---
# IMPORTANTE: Substitua estes valores com os dados reais do seu banco PostgreSQL
# ATENÇÃO: Se o PostgreSQL está na máquina host (não no Docker), use 'host.docker.internal'

# Nome da conexão no Airflow (padrão: postgres_prod)
# Este ID será usado nas DAGs para referenciar a conexão PostgreSQL
POSTGRES_CONN_ID=postgres_prod

# Credenciais do banco de dados
# NOTA: O prefixo POSTGRES_* NÃO é reservado pelo Airflow
# Você pode usar qualquer prefixo (ex: DB_*, SOURCE_*, etc)

# Host do PostgreSQL para SCRIPTS rodando no HOST (localhost ou IP real)
POSTGRES_HOST=localhost

# Host do PostgreSQL para AIRFLOW rodando em CONTAINER (host.docker.internal)
POSTGRES_HOST_DOCKER=host.docker.internal

POSTGRES_PORT=5432
POSTGRES_DB=your_production_database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password

# Schema do banco de dados (padrão: public)
# Se suas tabelas estão em outro schema, altere aqui
# Exemplo: public, dbo, myschema, etc.
POSTGRES_SCHEMA=public

# --- Azure Data Lake Storage Gen2 (Exportação de Dados) ---
# IMPORTANTE: Crie um Service Principal no Azure para o Airflow exportar dados
# Veja AZURE_DATALAKE.md para instruções completas
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_CONTAINER_NAME=tickets-data
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy
AZURE_CLIENT_SECRET=zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz

# =============================================================================
# NOTAS DE CONFIGURAÇÃO
# =============================================================================
# 
# 1. Este arquivo contém variáveis sensíveis. NÃO COMMITE no Git!
# 2. Certifique-se de que o arquivo .gitignore inclui .env
# 3. Para produção, use um gerenciador de secrets (AWS Secrets Manager, Vault, etc.)
# 
# 4. NOME DA CONEXÃO (POSTGRES_CONN_ID):
#    - Define o ID da conexão usado nas DAGs
#    - Se mudar, reinicie os containers: docker compose restart
#    - Valor padrão: postgres_prod
# 
# 5. PREFIXO DAS VARIÁVEIS (POSTGRES_*):
#    - NÃO é reservado pelo Airflow - pode usar qualquer nome
#    - É apenas convenção para organização
#    - Variáveis RESERVADAS pelo Airflow:
#      * AIRFLOW__*  (configurações do airflow.cfg)
#      * AIRFLOW_CONN_*  (definir conexões diretamente)
#      * AIRFLOW_VAR_*  (variáveis do Airflow)
# 
# 6. SCHEMA: O projeto usa o schema 'public' por padrão. Se suas tabelas
#    estão em outro schema (ex: public), ajuste POSTGRES_SCHEMA
# 
# 7. O usuário do banco precisa ter permissões de:
#    - USAGE e CREATE no schema (ex: GRANT USAGE, CREATE ON SCHEMA public TO usuario)
#    - SELECT em todas as tabelas (para ler dados de origem)
#    - CREATE (para criar views materializadas)
#    - SELECT (para ler tabelas)
#    - INSERT (para logs)
# 5. Se o banco estiver em outro servidor, certifique-se de que o Airflow
#    pode acessá-lo pela rede (firewall, security groups, etc.)
